# Normalize line endings for all text files to LF
* text=auto eol=lf

# Shell scripts must always use LF
*.sh text eol=lf
*.bash text eol=lf

# JSON files with LF
*.json text eol=lf
*.jsonc text eol=lf

# YAML files with LF
*.yml text eol=lf
*.yaml text eol=lf

# Lockfiles with LF
pnpm-lock.yaml text eol=lf
yarn.lock text eol=lf
package-lock.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
